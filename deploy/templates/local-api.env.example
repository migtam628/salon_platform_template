# Development-only identity. NEVER use publicly.
NODE_ENV=development
DEMO_MODE=true
PORT=4000
WEB_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
PUBLIC_WEB_URL=http://localhost:8080
TRUST_PROXY_HOPS=1
ACCESS_LOGS=false
MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=salon_local
SALON_TIME_ZONE=America/New_York
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_DEPOSIT_PERCENT=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
SALON_EMAIL_FROM=
