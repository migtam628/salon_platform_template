# PRIVATE CONFIGURATION: replace values in .deploy/staging-api.env.
# Do NOT commit that file or point staging at a production customer database.
NODE_ENV=production
DEMO_MODE=false
PORT=4000
WEB_ORIGIN=https://staging.example.com
PUBLIC_WEB_URL=https://staging.example.com
TRUST_PROXY_HOPS=1
ACCESS_LOGS=true
MONGODB_URI=
MONGODB_DB=salon_staging
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
ADMIN_USER_IDS=
SALON_TIME_ZONE=America/New_York
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_DEPOSIT_PERCENT=0
# Optional test-mode Stripe only; keep unset until test-mode acceptance.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
SALON_EMAIL_FROM=
