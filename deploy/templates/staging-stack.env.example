# Replace the example hostname with a staging DNS name that resolves here.
SALON_DEPLOY_MODE=staging
SALON_SITE_ADDRESS=staging.example.com
SALON_HTTP_BIND=0.0.0.0
SALON_HTTP_PORT=80
SALON_HTTPS_BIND=0.0.0.0
SALON_HTTPS_PORT=443
VITE_DEMO_MODE=false
# Public Appwrite browser configuration only; never place secrets in VITE_*.
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
