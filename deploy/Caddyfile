{$SITE_ADDRESS} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }

    handle /api/* {
        reverse_proxy api:4000
    }

    handle /socket.io/* {
        reverse_proxy api:4000
    }

    handle {
        root * /srv/salon
        try_files {path} /index.html
        file_server
    }
}
