# API (copy to apps/api/.env)
PORT=4000
WEB_ORIGIN=http://localhost:5173
DEMO_MODE=true
# Production must set NODE_ENV=production. In that mode, persistent auth/database,
# HTTPS origins and a trusted admin user ID are mandatory.
NODE_ENV=development
# Default 0. Only set 1 or 2 behind that many trusted reverse proxies, with
# direct API access blocked to prevent spoofed forwarded IP headers.
TRUST_PROXY_HOPS=0
# Structured request logs are automatically enabled in production.
ACCESS_LOGS=false
# Per-process defense-in-depth; also enforce shared limits at the public edge.
PUBLIC_RATE_LIMIT_MAX=300
BOOKING_RATE_LIMIT_MAX=15
CHECKOUT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=30
ADMIN_WRITE_RATE_LIMIT_MAX=60
MONGODB_URI=
MONGODB_DB=salon_platform
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_WEB_URL=http://localhost:5173
# 0 disables appointment deposits; set only after agreeing to the salon policy.
# Example: 25 means a 25% service deposit. Stripe keys/webhooks are required.
BOOKING_DEPOSIT_PERCENT=0
# IANA time zone for all appointment calendars (e.g., America/New_York)
SALON_TIME_ZONE=America/New_York
BOOKING_MIN_LEAD_MINUTES=60
# Optional: booking email notifications via Resend; a verified sender is required.
# When unset, emails are queued but are NOT sent.
RESEND_API_KEY=
SALON_EMAIL_FROM=

# Web (copy relevant values to apps/web/.env.local)
VITE_API_URL=
VITE_DEMO_MODE=true
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
