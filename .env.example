# API (copy to apps/api/.env)
PORT=4000
WEB_ORIGIN=http://localhost:5173
DEMO_MODE=true
MONGODB_URI=
MONGODB_DB=salon_platform
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_WEB_URL=http://localhost:5173
# IANA time zone for all appointment calendars (e.g., America/New_York)
SALON_TIME_ZONE=America/New_York
BOOKING_MIN_LEAD_MINUTES=60
# Optional: booking email notifications via Resend; a verified sender is required.
# When unset, emails are queued but are NOT sent.
RESEND_API_KEY=
SALON_EMAIL_FROM=

# Web (copy relevant values to apps/web/.env.local)
VITE_API_URL=
VITE_DEMO_MODE=true
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
